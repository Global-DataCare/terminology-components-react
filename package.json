{
  "name": "terminology-components-react",
  "version": "0.2.0",
  "description": "Accessible React and Next.js components for local terminology search",
  "author": "Connecting Solution & Applications Ltd. (ConnectHealth.info)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Global-DataCare/terminology-components-react.git"
  },
  "type": "module",
  "engines": { "node": ">=24" },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./autocomplete": { "types": "./dist/terminology-autocomplete.d.ts", "default": "./dist/terminology-autocomplete.js" },
    "./code-picker-v2": { "types": "./dist/terminology-code-picker-v2.d.ts", "default": "./dist/terminology-code-picker-v2.js" }
  },
  "files": ["dist", "README.md", "CHANGELOG.md", "LICENSE"],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm test",
    "prepack": "npm run check"
  },
  "dependencies": {
    "terminology-sdk-core-ts": "0.2.0"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^27.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.0"
  }
}
